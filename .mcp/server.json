{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chrispulman/crisscross-mcp-server",
  "title": "CrissCross MCP Server",
  "description": "CrissCross developer guidance for AI-assisted code generation, review, startup, navigation, controls, and preview-only project scaffolding.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "CrissCross.Mcp.Server",
      "version": "0.1.0",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DOTNET_SKIP_FIRST_TIME_EXPERIENCE",
          "value": "1",
          "description": "Skip .NET CLI first-time setup experience"
        },
        {
          "name": "DOTNET_NOLOGO",
          "value": "1",
          "description": "Suppress .NET logo and startup messages"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/ChrisPulman/CrissCross.MCP.Server",
    "source": "github"
  }
}
